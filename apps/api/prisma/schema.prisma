datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  INSPECTOR
  QUERY
  ADMIN
}

enum InspectionResult {
  QUALIFIED
  UNQUALIFIED
}

enum SpecialBarcodeType {
  DIRTY
  NO_BARCODE_PRODUCT
}

enum OperatorEmploymentType {
  FORMAL
  LABOR
}

enum DailyProductionPlanStatus {
  ACTIVE
  CLOSED
}

model User {
  id                 String             @id @default(cuid())
  username           String             @unique
  passwordHash       String
  role               Role
  isActive           Boolean            @default(true)
  mustChangePassword Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           Session[]
  inspectionRecords  InspectionRecord[] @relation("InspectorInspectionRecords")
  changeLogs         InspectionRecordChangeLog[] @relation("InspectionRecordChangeOperator")
}

model Session {
  id                  String         @id @default(cuid())
  tokenHash           String         @unique
  userId              String
  productionLineId    String
  createdAt           DateTime       @default(now())
  lastSeenAt          DateTime       @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?

  user              User           @relation(fields: [userId], references: [id])
  productionLine    ProductionLine @relation(fields: [productionLineId], references: [id])
  replacedBySession Session?       @relation("SessionReplacement", fields: [replacedBySessionId], references: [id])
  replacedSessions  Session[]      @relation("SessionReplacement")

  @@index([userId])
  @@index([productionLineId])
  @@index([expiresAt])
}

model ProductionLine {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  isActive          Boolean            @default(true)
  sortOrder         Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  inspectionRecords InspectionRecord[]
  dailyProductionPlans DailyProductionPlan[]
}

model DefectReason {
  id                    String                         @id @default(cuid())
  code                  String                         @unique
  name                  String
  deductionAmount       Decimal                        @default(0)
  isActive              Boolean                        @default(true)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  specialBarcodes       SpecialBarcode[]
  inspectionRecordLinks InspectionRecordDefectReason[]
}

model OperatorProfile {
  id                  String                 @id @default(cuid())
  employeeCode        String?                @unique
  name                String
  pinyinInitials      String
  employmentType      OperatorEmploymentType
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  inspectionRecords   InspectionRecord[]

  @@index([name])
  @@index([pinyinInitials])
  @@index([employmentType])
}

model SpecialBarcode {
  id             String             @id @default(cuid())
  type           SpecialBarcodeType
  barcode        String             @unique
  vehicleModel   String?
  partNumber     String?
  defectReasonId String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  defectReason DefectReason? @relation(fields: [defectReasonId], references: [id])

  @@index([defectReasonId])
}

model InspectionRecord {
  id                  String                         @id @default(cuid())
  barcode             String
  qualifiedBarcodeKey String?                        @unique
  partNumber          String
  productName         String?
  vehicleModel        String?
  partName            String?
  productionOrderNo   String?
  dailyProductionPlanId String?
  productionLineId    String
  inspectorId         String
  operatorProfileId   String?
  result              InspectionResult
  deductionAmount     Decimal                        @default(0)
  scannedAt           DateTime
  createdAt           DateTime                       @default(now())
  productionLine      ProductionLine                 @relation(fields: [productionLineId], references: [id])
  inspector           User                           @relation("InspectorInspectionRecords", fields: [inspectorId], references: [id])
  operatorProfile     OperatorProfile?               @relation(fields: [operatorProfileId], references: [id])
  defectReasonLinks   InspectionRecordDefectReason[]
  changeLogs          InspectionRecordChangeLog[]

  @@index([barcode])
  @@index([productionOrderNo])
  @@index([dailyProductionPlanId])
  @@index([productionLineId, scannedAt])
  @@index([inspectorId])
  @@index([operatorProfileId])
}

model ProductionOrderCache {
  id                String   @id @default(cuid())
  productionOrderNo String   @unique
  barcode           String?
  partNumber        String
  productName       String
  orderQuantity     Int
  rawJson           String?
  fetchedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([barcode])
  @@index([partNumber])
}

model DailyProductionPlan {
  id                String                    @id @default(cuid())
  businessDate      String
  productionOrderNo String
  partNumber        String
  productName       String
  orderQuantity     Int
  plannedQuantity   Int
  productionLineId  String
  status            DailyProductionPlanStatus @default(ACTIVE)
  closedAt          DateTime?
  createdById       String
  createdByUsername String
  updatedById       String
  updatedByUsername String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  productionLine    ProductionLine            @relation(fields: [productionLineId], references: [id])

  @@unique([businessDate, productionOrderNo, productionLineId])
  @@index([businessDate])
  @@index([productionOrderNo])
  @@index([productionLineId])
  @@index([status])
}

model InspectionRecordChangeLog {
  id                 String           @id @default(cuid())
  inspectionRecordId String
  operatorId         String
  barcode            String
  partNumber         String
  previousResult     InspectionResult
  newResult          InspectionResult
  defectReasonsJson  String
  operatedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())

  inspectionRecord InspectionRecord @relation(fields: [inspectionRecordId], references: [id])
  operator         User             @relation("InspectionRecordChangeOperator", fields: [operatorId], references: [id])

  @@index([inspectionRecordId])
  @@index([operatorId])
  @@index([operatedAt])
  @@index([barcode])
}

model OperationLog {
  id                String   @id @default(cuid())
  module            String
  action            String
  targetType        String
  targetId          String?
  targetLabel       String
  barcode           String?
  partNumber        String?
  previousResult    String?
  newResult         String?
  defectReasonsJson String?
  beforeJson        String?
  afterJson         String?
  operatorId        String
  operatorUsername  String
  operatedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([operatedAt])
  @@index([operatorUsername])
  @@index([barcode])
  @@index([module])
  @@index([targetType])
}

model InspectionRecordDefectReason {
  id                 String @id @default(cuid())
  inspectionRecordId String
  defectReasonId     String

  inspectionRecord InspectionRecord @relation(fields: [inspectionRecordId], references: [id], onDelete: Cascade)
  defectReason     DefectReason     @relation(fields: [defectReasonId], references: [id])

  @@unique([inspectionRecordId, defectReasonId])
  @@index([defectReasonId])
}
